# Local context-layer model (Ollama). Not secret.
OLLAMA_URL=http://127.0.0.1:11434
CONTEXT_MODEL=qwen2.5:3b

# "internal" destination: the organisation's own model (OpenAI-compatible endpoint)
INTERNAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
INTERNAL_LLM_MODEL=qwen2.5:3b
INTERNAL_LLM_API_KEY=

# "external" destination. Default: local Ollama standing in as a third-party API (simulated).
# Real API: set base URL, model and key, e.g. https://api.openai.com/v1
EXTERNAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
EXTERNAL_LLM_MODEL=qwen2.5:3b
EXTERNAL_LLM_API_KEY=

# Secret: HMAC key for the audit log. setup.sh generates one. Example value is fake.
AUDIT_HMAC_KEY=change-me

# Dev only: 1 shows a "Demo data / Worst case" switch with stress-test scenarios. Leave blank for demos.
CHAPERONE_DEV=

# Optional tuning. Defaults shown; uncomment to change.
# NER_MODEL=urchade/gliner_small-v2.1
# CONTEXT_TIMEOUT=20
# CONTEXT_CHUNK=250
# ATTACK_CATEGORIES=IDENTITY,HEALTH
# ATTACK_MAX_ROUNDS=2
# ATTACK_MIN_CONFIDENCE=0.7
# PORT=8000
